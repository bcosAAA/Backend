{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "verify",
			"type": "shell",
			"command": "mvn -B verify",
			"group": "build"
		},
		{
			"label": "test",
			"type": "shell",
			"command": "mvn -B test",
			"group": "test"
		},
		{
			"label": "tsc: build - tsconfig.json",
			"type": "typescript",
			"tsconfig": "tsconfig.json",
			"group": "build",
			"problemMatcher": [
				"$tsc"
			],
			"presentation": {
				"reveal": "silent"
			}
		}
	]
}